{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 140,
  "trailingComma": "es5",
  "importOrder": [
    "<TYPES>^(node:)",
    "<TYPES>",
    "<TYPES>^[.]",
    "",
    "^react$",
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "^@(?!components|drizzle|lib)/(.*)$",
    "^@components/(.*)$",
    "^@drizzle/(.*)$",
    "^@lib/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderTypeScriptVersion": "4.0.0",
  "tailwindStylesheet": "./app/styles/tailwind.css",
  "tailwindConfig": "./tailwind.config.ts",
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"]
}
