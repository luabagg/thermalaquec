{
  "name": "thermalaquec",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "typecheck": "tsc",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/server/index.js",
    "postinstall": "prisma generate",
    "prismaPull": "npx prisma db pull",
    "prismaPush": "npx prisma db push",
    "prismaMigrate": "npx prisma migrate dev",
    "supabaseTypes": "eval $(grep '^SUPABASE_ID' .env) && supabase gen types typescript --project-id ${SUPABASE_ID} > app/libs/supabase/database.types.ts",
    "envPull": "vercel env pull .env"
  },
  "dependencies": {
    "@heroui/react": "^2.6.14",
    "@prisma/client": "6.3.0",
    "@remix-run/node": "2.17.2",
    "@remix-run/react": "2.17.2",
    "@remix-run/serve": "2.17.2",
    "@remix-run/server-runtime": "2.17.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "@vercel/analytics": "^1.4.1",
    "@vercel/remix": "2.16.7",
    "@vercel/speed-insights": "^1.1.0",
    "framer-motion": "^12.0.6",
    "isbot": "^4.1.0",
    "jotai": "^2.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-floating-whatsapp": "^5.0.8",
    "react-icons": "^5.4.0",
    "react-scroll": "^1.9.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@remix-run/dev": "2.17.2",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@types/react-scroll": "^1.8.10",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.38",
    "prettier": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.1.6",
    "vite": "^5.1.0",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
