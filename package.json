{
  "name": "thermalaquec",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/server/index.js",
    "postinstall": "prisma generate",
    "prismaPull": "npx prisma db pull",
    "prismaPush": "npx prisma db push",
    "prismaMigrate": "npx prisma migrate dev",
    "prismaSeed": "npx prisma db seed",
    "catalogParse": "node scripts/canva-catalog/parse-catalog.mjs && node scripts/canva-catalog/review-catalog.mjs",
    "catalogNormalizeExport": "tsx scripts/catalog-normalization/export.ts",
    "catalogNormalizeValidate": "tsx scripts/catalog-normalization/validate.ts",
    "catalogNormalizeApply": "tsx scripts/catalog-normalization/apply.ts",
    "catalogNormalizeRevert": "tsx scripts/catalog-normalization/revert.ts",
    "supabaseTypes": "eval $(grep '^SUPABASE_ID' .env) && supabase gen types typescript --project-id ${SUPABASE_ID} > app/libs/supabase/database.types.ts",
    "envPull": "vercel env pull .env"
  },
  "dependencies": {
    "@prisma/client": "6.3.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@remix-run/node": "2.17.2",
    "@remix-run/react": "2.17.2",
    "@remix-run/serve": "2.17.2",
    "@remix-run/server-runtime": "2.17.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "@vercel/analytics": "^1.4.1",
    "@vercel/remix": "2.16.7",
    "@vercel/speed-insights": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.3.0",
    "isbot": "^4.1.0",
    "lucide-react": "^0.462.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-input-mask": "^2.0.4",
    "react-intersection-observer": "^9.16.0",
    "react-number-format": "^5.4.4",
    "react-whatsapp-widget": "^2.2.0",
    "sharp": "^0.35.4",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@remix-run/dev": "2.17.2",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@types/react-input-mask": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.38",
    "prettier": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.12",
    "typescript": "^5.1.6",
    "vite": "^5.1.0",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": "24.x"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
